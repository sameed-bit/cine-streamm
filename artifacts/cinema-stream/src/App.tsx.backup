import { useEffect, useState, type ReactNode } from 'react';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { Link, Route, Switch, useLocation, useParams, Router as WouterRouter } from 'wouter';
import { useGetDiscoverMedia, useGetGenres, useGetMovieDetails, useGetTrending, useGetTvDetails, useHealthCheck, useSearchCatalog, getGetDiscoverMediaQueryKey, getGetMovieDetailsQueryKey, getGetTrendingQueryKey, getGetTvDetailsQueryKey, getHealthCheckQueryKey, getSearchCatalogQueryKey } from '@workspace/api-client-react';
import type { Media, MediaDetails, Genre, Season } from '@workspace/api-client-react';
import { ArrowLeft, ArrowRight, Bookmark, Check, ChevronDown, CircleUserRound, Clapperboard, Clock3, Film, Info, List, LoaderCircle, Menu, Play, Search, Settings2, Sparkles, Star, Tv, UserRound, X } from 'lucide-react';
import { ErrorBoundary } from '@/components/error-boundary';
import { VideoPlayer } from '@/components/VideoPlayer';
import { Toaster } from '@/components/ui/toaster';
import { TooltipProvider } from '@/components/ui/tooltip';

const queryClient = new QueryClient();
const TMDB = 'https://image.tmdb.org/t/p/';
const poster = (path: string | null | undefined, size = 'w500') => path ? `${TMDB}${size}${path}` : '';
const year = (date?: string | null) => date?.slice(0, 4) || '—';
const duration = (runtime?: number | null) => runtime ? `${Math.floor(runtime / 60)}h ${runtime % 60}m` : 'Feature';
const safeJson = <T,>(key: string, fallback: T): T => { try { return JSON.parse(localStorage.getItem(key) || '') as T; } catch { return fallback; } };
const mediaKey = (item: Pick<Media, 'id' | 'media_type'>) => `${item.media_type}-${item.id}`;

function useSavedMedia() {
  const [saved, setSaved] = useState<string[]>(() => safeJson('cinema-my-list', []));
  const toggle = (item: Pick<Media, 'id' | 'media_type'>) => setSaved(current => {
    const key = mediaKey(item); const next = current.includes(key) ? current.filter(x => x !== key) : [...current, key];
    const stored = safeJson<Media[]>('cinema-list-items', []);
    const nextItems = next.includes(key) ? [...stored.filter(x => mediaKey(x) !== key), item as Media] : stored.filter(x => mediaKey(x) !== key);
    localStorage.setItem('cinema-my-list', JSON.stringify(next)); localStorage.setItem('cinema-list-items', JSON.stringify(nextItems)); return next;
  });
  return { saved, toggle };
}

function Poster({ item, className = '', eager = false }: { item: Media; className?: string; eager?: boolean }) {
  const [failed, setFailed] = useState(false);
  return <div className={`group/poster relative overflow-hidden bg-[hsl(var(--muted))] ${className}`}>
    {item.poster_path && !failed ? <img src={poster(item.poster_path)} alt={`${item.title} poster`} loading={eager ? 'eager' : 'lazy'} onError={() => setFailed(true)} className="h-full w-full object-cover transition duration-500 group-hover/poster:scale-105" /> : <div className="flex h-full flex-col justify-end bg-[radial-gradient(circle_at_35%_20%,hsl(353_71%_51%/.65),transparent_45%),linear-gradient(145deg,hsl(224_24%_18%),hsl(222_23%_7%))] p-4"><Film className="mb-auto h-7 w-7 text-[hsl(var(--accent))]" /><span className="font-display text-lg leading-tight text-foreground">{item.title}</span></div>}
    <div className="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-70" />
  </div>;
}

function Skeleton({ className = '' }: { className?: string }) { return <div className={`animate-pulse rounded-sm bg-[hsl(var(--muted))] ${className}`} />; }
function LoadingRail() { return <div className="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-6">{Array.from({ length: 6 }).map((_, i) => <Skeleton key={i} className="aspect-[2/3]" />)}</div>; }
function QueryMessage({ error, retry }: { error?: unknown; retry?: () => void }) { return <div className="flex min-h-36 flex-col items-center justify-center border border-dashed border-[hsl(var(--border))] bg-[hsl(var(--card)/.45)] px-5 text-center"><Info className="mb-3 h-5 w-5 text-[hsl(var(--accent))]" /><p className="text-sm text-muted-foreground">{error ? 'The projector missed a frame. Try again.' : 'Nothing is playing in this reel yet.'}</p>{retry && <button data-testid="button-retry" onClick={retry} className="mt-3 text-xs font-bold uppercase tracking-[.18em] text-primary">Try again</button>}</div>; }

function MarkButton({ item, saved, toggle }: { item: Media; saved: boolean; toggle: (item: Pick<Media, 'id' | 'media_type'>) => void }) {
  return <button aria-label={saved ? `Remove ${item.title} from My List` : `Add ${item.title} to My List`} data-testid={`button-save-${item.media_type}-${item.id}`} onClick={() => toggle(item)} className={`absolute right-2 top-2 z-10 flex h-9 w-9 items-center justify-center border border-white/15 bg-black/55 text-white backdrop-blur transition hover:border-primary hover:bg-primary ${saved ? 'bg-primary' : ''}`}><Bookmark className={`h-4 w-4 ${saved ? 'fill-current' : ''}`} /></button>;
}

function MediaCard({ item, saved, toggle }: { item: Media; saved?: boolean; toggle?: (item: Pick<Media, 'id' | 'media_type'>) => void }) {
  const href = item.media_type === 'movie' ? `/movie/${item.id}` : `/tv/${item.id}`;
  return <div data-testid={`card-media-${item.media_type}-${item.id}`} className="min-w-0">
    <div className="relative aspect-[2/3] overflow-hidden border border-white/5 transition duration-300 hover:-translate-y-1 hover:border-primary/50 hover:shadow-[0_16px_40px_hsl(353_71%_15%/.45)]">
      {toggle && <MarkButton item={item} saved={!!saved} toggle={toggle} />}
      <Link href={href} aria-label={`View ${item.title}`} data-testid={`link-media-${item.media_type}-${item.id}`} className="block h-full"><Poster item={item} /></Link>
      <Link href={href} className="absolute inset-x-0 bottom-0 z-[1] bg-gradient-to-t from-black/90 to-transparent px-3 pb-3 pt-10 text-white opacity-0 transition group-hover:opacity-100 focus:opacity-100"><span className="text-xs font-semibold">{item.title}</span></Link>
    </div>
    <div className="flex items-start justify-between gap-2 pt-2"><Link href={href} className="line-clamp-1 text-sm font-semibold text-foreground hover:text-primary">{item.title}</Link><span className="shrink-0 font-mono text-[10px] text-muted-foreground">{year(item.release_date)}</span></div>
    <div className="mt-1 flex items-center gap-1 font-mono text-[10px] text-[hsl(var(--accent))]"><Star className="h-3 w-3 fill-current" />{item.vote_average ? item.vote_average.toFixed(1) : 'NR'}</div>
  </div>;
}

function Rail({ title, eyebrow, items, saved, toggle, href }: { title: string; eyebrow?: string; items?: Media[]; saved: string[]; toggle: (item: Pick<Media, 'id' | 'media_type'>) => void; href?: string }) {
  return <section className="space-y-4"><div className="flex items-end justify-between border-b border-white/10 pb-3"><div><p className="font-mono text-[10px] uppercase tracking-[.22em] text-primary">{eyebrow || 'Curated for tonight'}</p><h2 className="mt-1 font-display text-2xl text-foreground sm:text-3xl">{title}</h2></div>{href && <Link href={href} data-testid={`link-see-all-${title.toLowerCase().replaceAll(' ', '-')}`} className="flex items-center gap-2 text-xs font-bold uppercase tracking-[.15em] text-muted-foreground transition hover:text-foreground">See all <ArrowRight className="h-4 w-4" /></Link>}</div>{items?.length ? <div className="grid grid-cols-2 gap-x-3 gap-y-7 sm:grid-cols-4 lg:grid-cols-6">{items.map(item => <MediaCard key={mediaKey(item)} item={item} saved={saved.includes(mediaKey(item))} toggle={toggle} />)}</div> : <QueryMessage />}</section>;
}

function Shell({ children }: { children: ReactNode }) {
  const [location, setLocation] = useLocation();
  const [menu, setMenu] = useState(false);
  const nav = [{ href: '/', label: 'Tonight', icon: Clapperboard }, { href: '/movies', label: 'Movies', icon: Film }, { href: '/tv-shows', label: 'Series', icon: Tv }, { href: '/genres', label: 'Genres', icon: List }];
  return <div className="min-h-[100dvh] bg-background">
    <header className="fixed inset-x-0 top-0 z-40 border-b border-white/10 bg-[hsl(var(--background)/.88)] backdrop-blur-xl"><div className="mx-auto flex h-16 max-w-[1480px] items-center gap-5 px-5 lg:px-10">
      <button data-testid="button-menu" aria-label="Open navigation" onClick={() => setMenu(!menu)} className="lg:hidden"><Menu className="h-5 w-5" /></button>
      <Link href="/" data-testid="link-logo" className="flex items-center gap-2.5"><span className="flex h-7 w-7 items-center justify-center bg-primary text-primary-foreground"><Clapperboard className="h-4 w-4" /></span><span className="font-mono text-sm font-medium tracking-[.18em] text-foreground">CINEMA<span className="text-primary">/</span>STREAM</span></Link>
      <nav className={`${menu ? 'flex' : 'hidden'} absolute left-0 right-0 top-16 flex-col gap-1 border-b border-white/10 bg-[hsl(var(--sidebar))] p-4 lg:static lg:flex lg:flex-row lg:items-center lg:border-0 lg:bg-transparent lg:p-0`}>
        {nav.map(({ href, label, icon: Icon }) => <Link key={href} href={href} data-testid={`link-nav-${label.toLowerCase()}`} onClick={() => setMenu(false)} className={`flex items-center gap-2 px-3 py-2 text-xs font-bold uppercase tracking-[.14em] transition hover:text-foreground ${location === href ? 'text-foreground' : 'text-muted-foreground'}`}><Icon className={`h-4 w-4 ${location === href ? 'text-primary' : ''}`} />{label}</Link>)}
      </nav>
      <div className="ml-auto flex items-center gap-1"><Link href="/search" aria-label="Search" data-testid="link-search" className="flex h-9 w-9 items-center justify-center text-muted-foreground transition hover:text-foreground"><Search className="h-4 w-4" /></Link><Link href="/my-list" aria-label="My List" data-testid="link-my-list" className="flex h-9 w-9 items-center justify-center text-muted-foreground transition hover:text-foreground"><Bookmark className="h-4 w-4" /></Link><Link href="/profile" data-testid="link-profile" className="ml-1 flex h-8 w-8 items-center justify-center border border-white/15 bg-secondary text-muted-foreground transition hover:border-primary hover:text-foreground"><UserRound className="h-4 w-4" /></Link></div>
    </div></header>
    <main className="mx-auto max-w-[1480px] px-5 pb-20 pt-16 lg:px-10">{children}</main>
    <footer className="border-t border-white/10 px-5 py-8 lg:px-10"><div className="mx-auto flex max-w-[1480px] flex-col justify-between gap-4 text-xs text-muted-foreground sm:flex-row"><span className="font-mono tracking-[.16em]">CINEMA/STREAM</span><span>A quiet place for a great watch.</span><div className="flex gap-4"><Link href="/profile" className="hover:text-foreground">Profile</Link><Link href="/about" className="hover:text-foreground">Credits</Link><Link href="/admin" className="hover:text-foreground">Studio access</Link></div></div></footer>
  </div>;
}

function Home() {
  const trending = useGetTrending({ query: { queryKey: getGetTrendingQueryKey() } });
  const { data: popularMovies, isLoading: moviesLoading, isError: moviesError, refetch: refetchMovies } = useGetDiscoverMedia({ type: 'movie', category: 'popular' }, { query: { queryKey: getGetDiscoverMediaQueryKey({ type: 'movie', category: 'popular' }) } });
  const { data: topTv } = useGetDiscoverMedia({ type: 'tv', category: 'top_rated' }, { query: { queryKey: getGetDiscoverMediaQueryKey({ type: 'tv', category: 'top_rated' }) } });
  const { saved, toggle } = useSavedMedia();
  const hero = trending.data?.items?.[0] || popularMovies?.items?.[0];
  return <div className="space-y-16">
    <section className="relative -mx-5 min-h-[570px] overflow-hidden border-b border-white/10 lg:-mx-10">
      {hero?.backdrop_path ? <img src={poster(hero.backdrop_path, 'original')} alt="" className="absolute inset-0 h-full w-full object-cover opacity-60" /> : <div className="absolute inset-0 bg-[radial-gradient(ellipse_at_70%_22%,hsl(353_71%_34%/.8),transparent_45%),linear-gradient(115deg,hsl(222_23%_7%),hsl(222_23%_12%))]" />}
      <div className="absolute inset-0 bg-gradient-to-r from-background via-background/75 to-background/15" /><div className="absolute inset-0 bg-gradient-to-t from-background via-transparent to-background/10" />
      <div className="relative flex min-h-[570px] max-w-2xl flex-col justify-end px-5 pb-14 lg:px-10 lg:pb-20"><p className="animate-rise-in font-mono text-[10px] uppercase tracking-[.28em] text-primary" style={{ animationDelay: '80ms' }}>Your private theater · 01</p><h1 className="animate-rise-in mt-5 max-w-xl font-display text-5xl leading-[.95] text-balance sm:text-7xl" style={{ animationDelay: '140ms' }}>{hero?.title || 'Something worth staying up for.'}</h1><p className="animate-rise-in mt-5 max-w-lg text-sm leading-7 text-muted-foreground sm:text-base" style={{ animationDelay: '220ms' }}>{hero?.overview || 'A handpicked stream of films and series for the hours when everything else goes quiet.'}</p><div className="animate-rise-in mt-7 flex flex-wrap gap-3" style={{ animationDelay: '300ms' }}><Link href={hero ? `/${hero.media_type === 'movie' ? 'movie' : 'tv'}/${hero.id}` : '/movies'} data-testid="link-hero-discover" className="flex items-center gap-2 bg-primary px-5 py-3 text-xs font-bold uppercase tracking-[.15em] text-primary-foreground transition hover:bg-primary/85"><Play className="h-4 w-4 fill-current" /> Explore title</Link><Link href="/my-list" data-testid="link-hero-list" className="flex items-center gap-2 border border-white/20 bg-black/20 px-5 py-3 text-xs font-bold uppercase tracking-[.15em] text-foreground backdrop-blur transition hover:border-white/50"><Bookmark className="h-4 w-4" /> My List</Link></div></div>
      <div className="absolute bottom-7 right-5 hidden font-mono text-[10px] tracking-[.24em] text-muted-foreground lg:block">CURATED DISCOVERY / 2024—25</div>
    </section>
    <section className="grid gap-5 border-y border-white/10 py-5 sm:grid-cols-3"><div><p className="font-mono text-[10px] tracking-[.2em] text-primary">01 / THE SIGNAL</p><p className="mt-2 text-sm text-muted-foreground">Real catalog data, chosen with a little taste.</p></div><div><p className="font-mono text-[10px] tracking-[.2em] text-primary">02 / NO NOISE</p><p className="mt-2 text-sm text-muted-foreground">One search. Movies, series, and the people behind them.</p></div><div><p className="font-mono text-[10px] tracking-[.2em] text-primary">03 / YOUR ROOM</p><p className="mt-2 text-sm text-muted-foreground">Keep a list and pick up where you left off, locally.</p></div></section>
    <Rail title="Trending after dark" eyebrow="The room is filling up" items={trending.data?.items} saved={saved} toggle={toggle} href="/movies" />
    <Rail title="Popular right now" eyebrow="A reliable first choice" items={moviesLoading ? undefined : popularMovies?.items} saved={saved} toggle={toggle} href="/movies" />
    <Rail title="The long way home" eyebrow="Series with somewhere to go" items={topTv?.items} saved={saved} toggle={toggle} href="/tv-shows" />
    {moviesError && <QueryMessage error retry={() => refetchMovies()} />}
  </div>;
}

function Browse({ type }: { type: 'movie' | 'tv' }) {
  const [category, setCategory] = useState<'popular' | 'top_rated' | 'now_playing' | 'upcoming'>('popular');
  const result = useGetDiscoverMedia({ type, category }, { query: { queryKey: getGetDiscoverMediaQueryKey({ type, category }) } });
  const { saved, toggle } = useSavedMedia();
  const labels = { popular: 'Popular', top_rated: 'Top rated', now_playing: 'In theaters', upcoming: 'Coming soon' };
  return <div className="space-y-9 pt-10"><PageIntro kicker={type === 'movie' ? 'The feature shelf' : 'The series shelf'} title={type === 'movie' ? 'Movies' : 'TV shows'} copy={type === 'movie' ? 'Big swings, quiet gems, and the ones everyone will be talking about.' : 'Long-form stories for a night you do not want to end.'} /><div className="flex flex-wrap gap-2">{Object.entries(labels).map(([key, label]) => <button key={key} data-testid={`button-category-${key}`} onClick={() => setCategory(key as typeof category)} className={`border px-4 py-2 text-xs font-bold uppercase tracking-[.12em] transition ${category === key ? 'border-primary bg-primary text-primary-foreground' : 'border-white/15 text-muted-foreground hover:border-white/40 hover:text-foreground'}`}>{label}</button>)}</div>{result.isLoading ? <LoadingRail /> : result.isError ? <QueryMessage error retry={() => result.refetch()} /> : <div className="grid grid-cols-2 gap-x-3 gap-y-9 sm:grid-cols-4 lg:grid-cols-6">{result.data?.items?.map(item => <MediaCard key={mediaKey(item)} item={item} saved={saved.includes(mediaKey(item))} toggle={toggle} />)}</div>}</div>;
}

function Genres() {
  const genres = useGetGenres();
  const [selected, setSelected] = useState<{ id: number; name: string; type: 'movie' | 'tv' } | null>(null);
  const { saved, toggle } = useSavedMedia();
  const result = useGetDiscoverMedia({ type: selected?.type || 'movie', category: 'popular', genre: selected?.id }, { query: { enabled: !!selected, queryKey: getGetDiscoverMediaQueryKey({ type: selected?.type || 'movie', category: 'popular', genre: selected?.id }) } });
  const all = [...(genres.data?.movies || []), ...(genres.data?.tv || [])].filter((item, index, arr) => arr.findIndex(x => x.id === item.id) === index);
  return <div className="space-y-10 pt-10"><PageIntro kicker="A world of stories" title="Browse by mood" copy="Start with a feeling. We will take care of the rest." />{genres.isLoading ? <div className="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-6">{Array.from({ length: 12 }).map((_, i) => <Skeleton key={i} className="h-24" />)}</div> : genres.isError ? <QueryMessage error retry={() => genres.refetch()} /> : <><div className="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-6">{all.map((genre, i) => <button key={genre.id} data-testid={`button-genre-${genre.id}`} onClick={() => setSelected({ ...genre, type: i % 2 ? 'tv' : 'movie' })} className={`group relative h-28 overflow-hidden border p-4 text-left transition hover:-translate-y-1 hover:border-primary ${selected?.id === genre.id ? 'border-primary bg-primary/15' : 'border-white/10 bg-card'}`}><span className="font-mono text-[10px] text-primary">0{(i % 9) + 1}</span><span className="absolute bottom-4 left-4 font-display text-lg">{genre.name}</span><ArrowRight className="absolute right-4 top-4 h-4 w-4 text-muted-foreground transition group-hover:translate-x-1 group-hover:text-primary" /></button>)}</div>{selected && <section className="space-y-4 border-t border-white/10 pt-8"><div className="flex items-center justify-between"><h2 className="font-display text-3xl">{selected.name}<span className="ml-3 font-mono text-xs text-muted-foreground">/ {selected.type === 'movie' ? 'films' : 'series'}</span></h2><button data-testid="button-close-genre" onClick={() => setSelected(null)} className="text-muted-foreground hover:text-foreground"><X className="h-5 w-5" /></button></div>{result.isLoading ? <LoadingRail /> : result.isError ? <QueryMessage error retry={() => result.refetch()} /> : <div className="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-6">{result.data?.items?.map(item => <MediaCard key={mediaKey(item)} item={item} saved={saved.includes(mediaKey(item))} toggle={toggle} />)}</div>}</section>}</>}</div>;
}

function SearchPage() {
  const [input, setInput] = useState(''); const [query, setQuery] = useState(''); const [filter, setFilter] = useState<'all' | 'movie' | 'tv' | 'person'>('all');
  useEffect(() => { const timer = window.setTimeout(() => setQuery(input.trim()), 350); return () => window.clearTimeout(timer); }, [input]);
  const result = useSearchCatalog({ query, filter }, { query: { enabled: query.length > 0, queryKey: getSearchCatalogQueryKey({ query, filter }) } });
  const { saved, toggle } = useSavedMedia();
  const filters = [['all', 'Everything'], ['movie', 'Movies'], ['tv', 'Series'], ['person', 'People']] as const;
  return <div className="space-y-10 pt-10"><PageIntro kicker="Find your next thing" title="Search the catalog" copy="Titles, characters, directors, and the feeling you cannot quite name." /><div className="relative max-w-3xl"><Search className="absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-primary" /><input autoFocus value={input} onChange={e => setInput(e.target.value)} data-testid="input-search" placeholder="Try “quiet sci-fi” or a name" className="h-16 w-full border border-white/15 bg-card pl-12 pr-4 text-lg text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none" /></div><div className="flex gap-2 border-b border-white/10 pb-5">{filters.map(([value, label]) => <button key={value} data-testid={`button-filter-${value}`} onClick={() => setFilter(value)} className={`px-3 py-2 text-xs font-bold uppercase tracking-[.12em] transition ${filter === value ? 'text-primary' : 'text-muted-foreground hover:text-foreground'}`}>{label}</button>)}</div>{!query ? <div className="flex min-h-64 items-center border border-dashed border-white/10 px-6"><div><Sparkles className="h-5 w-5 text-[hsl(var(--accent))]" /><p className="mt-4 font-display text-2xl">The right film is usually one thought away.</p><p className="mt-2 text-sm text-muted-foreground">Search by title, genre, performer, or director.</p></div></div> : result.isLoading ? <LoadingRail /> : result.isError ? <QueryMessage error retry={() => result.refetch()} /> : <div className="space-y-10"><section><div className="mb-4 flex items-center gap-3"><h2 className="font-display text-2xl">Titles</h2><span className="font-mono text-[10px] text-muted-foreground">{result.data?.items?.length || 0} found</span></div>{result.data?.items?.length ? <div className="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-6">{result.data.items.map(item => <MediaCard key={mediaKey(item)} item={item} saved={saved.includes(mediaKey(item))} toggle={toggle} />)}</div> : <QueryMessage />}</section>{result.data?.people?.length ? <section><h2 className="mb-4 font-display text-2xl">People</h2><div className="grid gap-3 sm:grid-cols-3 lg:grid-cols-5">{result.data.people.map(person => <div key={person.id} data-testid={`card-person-${person.id}`} className="flex items-center gap-3 border border-white/10 bg-card p-3"><div className="h-12 w-12 shrink-0 overflow-hidden bg-muted">{person.profile_path ? <img src={poster(person.profile_path, 'w185')} alt={`${person.name} portrait`} className="h-full w-full object-cover" /> : <div className="flex h-full items-center justify-center font-display text-lg text-primary">{person.name[0]}</div>}</div><div><p className="text-sm font-semibold">{person.name}</p><p className="mt-1 font-mono text-[9px] uppercase tracking-wider text-muted-foreground">{person.known_for_department}</p></div></div>)}</div></section> : null}</div>}</div>;
}

function PageIntro({ kicker, title, copy }: { kicker: string; title: string; copy: string }) { return <div className="max-w-2xl"><p className="font-mono text-[10px] uppercase tracking-[.25em] text-primary">{kicker}</p><h1 className="mt-3 font-display text-5xl leading-none sm:text-6xl">{title}</h1><p className="mt-4 text-sm leading-7 text-muted-foreground sm:text-base">{copy}</p></div>; }

function Detail({ type }: { type: 'movie' | 'tv' }) {
  const params = useParams<{ id: string }>(); const id = Number(params.id);
  const query = type === 'movie' ? useGetMovieDetails(id, { query: { enabled: !!id, queryKey: getGetMovieDetailsQueryKey(id) } }) : useGetTvDetails(id, { query: { enabled: !!id, queryKey: getGetTvDetailsQueryKey(id) } });
  const detail = query.data as MediaDetails | undefined; const { saved, toggle } = useSavedMedia();
  if (query.isLoading) return <div className="space-y-5 pt-10"><Skeleton className="h-[52vh]" /><Skeleton className="h-8 w-1/2" /></div>;
  if (query.isError || !detail) return <div className="pt-24"><QueryMessage error retry={() => query.refetch()} /></div>;
  const item = detail; const href = type === 'movie' ? `/watch/movie/${id}` : `/watch/tv/${id}/1/1`;
  return <div className="relative -mx-5 -mt-0 overflow-hidden lg:-mx-10"><div className="relative min-h-[620px] border-b border-white/10"><div className="absolute inset-0">{detail.backdrop_path ? <img src={poster(detail.backdrop_path, 'original')} alt="" className="h-full w-full object-cover opacity-45" /> : null}<div className="absolute inset-0 bg-gradient-to-r from-background via-background/75 to-background/20" /><div className="absolute inset-0 bg-gradient-to-t from-background via-transparent to-background/10" /></div><div className="relative flex min-h-[620px] items-end px-5 pb-14 lg:px-10 lg:pb-20"><div className="grid w-full max-w-5xl gap-8 sm:grid-cols-[180px_1fr] sm:items-end"><Poster item={item} className="hidden aspect-[2/3] max-w-[180px] shadow-2xl sm:block" eager /><div className="max-w-2xl"><Link href={`/${type === 'movie' ? 'movies' : 'tv-shows'}`} className="mb-7 inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[.18em] text-muted-foreground hover:text-foreground"><ArrowLeft className="h-3 w-3" /> Back to shelf</Link><p className="font-mono text-[10px] uppercase tracking-[.25em] text-primary">{type === 'movie' ? 'Feature film' : 'Original series'} / {year(detail.release_date)}</p><h1 className="mt-3 font-display text-5xl leading-[.94] sm:text-7xl">{detail.title}</h1><div className="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-[10px] uppercase tracking-wider text-muted-foreground"><span className="flex items-center gap-1 text-[hsl(var(--accent))]"><Star className="h-3 w-3 fill-current" /> {detail.vote_average.toFixed(1)} / 10</span><span>{duration(detail.runtime)}</span><span>{detail.genres?.map(g => g.name).join(' · ')}</span></div><p className="mt-6 max-w-xl text-sm leading-7 text-muted-foreground">{detail.overview || 'A story waiting to be discovered.'}</p><div className="mt-7 flex flex-wrap gap-3"><Link href={href} data-testid="link-watch-now" className="flex items-center gap-2 bg-primary px-5 py-3 text-xs font-bold uppercase tracking-[.15em] text-primary-foreground hover:bg-primary/85"><Play className="h-4 w-4 fill-current" /> Watch now</Link><button data-testid="button-detail-save" onClick={() => toggle(item)} className="flex items-center gap-2 border border-white/20 px-5 py-3 text-xs font-bold uppercase tracking-[.15em] hover:border-white/50"><Bookmark className={`h-4 w-4 ${saved.includes(mediaKey(item)) ? 'fill-primary text-primary' : ''}`} /> {saved.includes(mediaKey(item)) ? 'Saved' : 'My List'}</button></div></div></div></div></div><div className="space-y-14 px-5 py-12 lg:px-10"><section className="grid gap-8 md:grid-cols-[1fr_2fr]"><div><p className="font-mono text-[10px] uppercase tracking-[.2em] text-primary">The note</p><h2 className="mt-2 font-display text-3xl">Stay for the details.</h2></div><div><p className="text-sm leading-7 text-muted-foreground">A high-signal pick with {detail.vote_count?.toLocaleString() || 'a growing audience'} votes. Keep it close for the night you want something with a little atmosphere.</p>{detail.production_companies?.length ? <p className="mt-5 font-mono text-[10px] uppercase tracking-wider text-muted-foreground">{detail.production_companies.join(' / ')}</p> : null}</div></section>{type === 'tv' && <SeasonList seasons={detail.seasons || []} id={id} />}{detail.cast?.length ? <section><div className="mb-5 flex items-end justify-between border-b border-white/10 pb-3"><div><p className="font-mono text-[10px] uppercase tracking-[.2em] text-primary">On screen</p><h2 className="mt-1 font-display text-3xl">The cast</h2></div></div><div className="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-6">{detail.cast.slice(0, 6).map(actor => <div key={actor.id} className="border border-white/10 bg-card p-2"><div className="aspect-square overflow-hidden bg-muted">{actor.profile_path ? <img src={poster(actor.profile_path, 'w185')} alt={`${actor.name} as ${actor.character}`} loading="lazy" className="h-full w-full object-cover" /> : <div className="flex h-full items-center justify-center font-display text-2xl text-primary">{actor.name[0]}</div>}</div><p className="mt-2 text-sm font-semibold">{actor.name}</p><p className="mt-1 line-clamp-1 text-xs text-muted-foreground">{actor.character}</p></div>)}</div></section> : null}</div></div>;
}

function SeasonList({ seasons, id }: { seasons: Season[]; id: number }) { const [open, setOpen] = useState(seasons.find(x => x.season_number > 0)?.season_number || 1); return <section><div className="mb-5 flex items-end justify-between border-b border-white/10 pb-3"><div><p className="font-mono text-[10px] uppercase tracking-[.2em] text-primary">Keep going</p><h2 className="mt-1 font-display text-3xl">Episodes</h2></div><div className="relative"><select value={open} onChange={e => setOpen(Number(e.target.value))} data-testid="select-season" className="appearance-none border border-white/15 bg-card py-2 pl-3 pr-8 text-xs font-bold text-foreground"><option disabled>Season</option>{seasons.filter(s => s.season_number > 0).map(s => <option key={s.season_number} value={s.season_number}>{s.name}</option>)}</select><ChevronDown className="pointer-events-none absolute right-2 top-2.5 h-3 w-3" /></div></div><div className="divide-y divide-white/10 border-y border-white/10">{Array.from({ length: Math.min(seasons.find(s => s.season_number === open)?.episode_count || 8, 8) }).map((_, i) => <Link href={`/watch/tv/${id}/${open}/${i + 1}`} key={i} data-testid={`link-episode-${open}-${i + 1}`} className="group flex items-center gap-4 py-4 transition hover:bg-white/[.03]"><span className="w-7 font-mono text-xs text-muted-foreground">E{i + 1}</span><span className="flex h-9 w-9 items-center justify-center border border-white/15 text-primary transition group-hover:border-primary group-hover:bg-primary group-hover:text-primary-foreground"><Play className="h-3 w-3 fill-current" /></span><span className="text-sm font-semibold">Episode {i + 1}</span><span className="ml-auto font-mono text-[10px] text-muted-foreground">Watch episode</span></Link>)}</div></section>; }

function Watch({ type }: { type: 'movie' | 'tv' }) {
  const params = useParams<{ id: string; season?: string; episode?: string }>();
  const id = Number(params.id);
  const detailQuery = type === 'movie' ? useGetMovieDetails(id, { query: { enabled: !!id, queryKey: getGetMovieDetailsQueryKey(id) } }) : useGetTvDetails(id, { query: { enabled: !!id, queryKey: getGetTvDetailsQueryKey(id) } });
  const title = type === 'movie' ? 'Your feature is ready.' : `Season ${params.season}, episode ${params.episode}`;
  const saveProgress = (progress: { event: string; currentTime: number; duration: number; percent: number }) => {
    const progressKey = `cinema-progress-${type}-${id}`;
    localStorage.setItem(progressKey, JSON.stringify({ ...progress, id, type, season: params.season, episode: params.episode, updatedAt: new Date().toISOString() }));
    const item = detailQuery.data;
    if (item && ["play", "timeupdate", "ended"].includes(progress.event)) {
      const history = safeJson<Media[]>('cinema-history-items', []);
      localStorage.setItem('cinema-history-items', JSON.stringify([item, ...history.filter(x => mediaKey(x) !== mediaKey(item))].slice(0, 20)));
    }
  };
  return <div className="mx-auto max-w-6xl space-y-6 pt-10"><Link href={type === 'movie' ? `/movie/${params.id}` : `/tv/${params.id}`} className="inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[.18em] text-muted-foreground hover:text-foreground"><ArrowLeft className="h-3 w-3" /> Exit player</Link><VideoPlayer type={type} id={id} season={Number(params.season)} episode={Number(params.episode)} onProgress={saveProgress} /><div className="flex flex-col justify-between gap-3 border-b border-white/10 pb-5 sm:flex-row sm:items-center"><div><p className="font-mono text-[10px] uppercase tracking-[.2em] text-primary">Now showing</p><h1 className="mt-1 font-display text-3xl">{title}</h1></div><div className="flex items-center gap-2 text-xs text-muted-foreground"><Clock3 className="h-4 w-4" /> Progress is saved on this device</div></div></div>;
}

function LocalCollection({ history = false }: { history?: boolean }) {
  const [items, setItems] = useState<Media[]>(() => safeJson(history ? 'cinema-history-items' : 'cinema-list-items', []));
  const { saved, toggle } = useSavedMedia();
  useEffect(() => { if (!history) { const list = safeJson<string[]>('cinema-my-list', []); setItems(safeJson<Media[]>('cinema-list-items', []).filter(item => list.includes(mediaKey(item)))); } }, [history, saved]);
  return <div className="space-y-10 pt-10"><PageIntro kicker={history ? 'Your recent screenings' : 'Kept close'} title={history ? 'History' : 'My List'} copy={history ? 'Pick up a story where you left it. Your progress stays on this device.' : 'A private shelf for the titles you are not ready to lose.'} />{items.length ? <div className="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-6">{items.map(item => <MediaCard key={mediaKey(item)} item={item} saved={saved.includes(mediaKey(item))} toggle={toggle} />)}</div> : <div className="border border-dashed border-white/15 bg-card/40 p-10 sm:p-16"><Bookmark className="h-6 w-6 text-primary" /><h2 className="mt-5 font-display text-3xl">{history ? 'Your story has not started yet.' : 'Save a few for later.'}</h2><p className="mt-2 max-w-md text-sm leading-6 text-muted-foreground">{history ? 'Start watching from any title page and your local history will appear here.' : 'Tap the bookmark on anything that catches your eye. No account required.'}</p><Link href={history ? '/movies' : '/'} className="mt-6 inline-flex items-center gap-2 bg-primary px-4 py-3 text-xs font-bold uppercase tracking-[.15em] text-primary-foreground">{history ? 'Browse movies' : 'Find something'} <ArrowRight className="h-4 w-4" /></Link></div>}</div>;
}

function Profile() { const health = useHealthCheck({ query: { queryKey: getHealthCheckQueryKey() } }); return <div className="space-y-10 pt-10"><PageIntro kicker="Your screening room" title="Profile" copy="A private control panel for this device. Your saved titles and watch progress stay close while you browse." /><div className="grid gap-5 lg:grid-cols-[1.3fr_.7fr]"><div className="border border-white/10 bg-card p-7 sm:p-10"><div className="flex items-start justify-between"><div className="flex h-14 w-14 items-center justify-center border border-primary/40 bg-primary/10 text-primary"><CircleUserRound className="h-7 w-7" /></div><span className="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">Local profile</span></div><h2 className="mt-8 font-display text-4xl">Make the room yours.</h2><p className="mt-3 max-w-lg text-sm leading-7 text-muted-foreground">Tune the way Cinema Stream feels on this device. The catalog stays open, and your personal shelf is ready whenever you are.</p><Link href="/settings" data-testid="link-profile-settings" className="mt-7 inline-flex items-center gap-2 bg-primary px-5 py-3 text-xs font-bold uppercase tracking-[.15em] text-primary-foreground">Open preferences <ArrowRight className="h-4 w-4" /></Link></div><div className="space-y-5"><div className="border border-white/10 bg-card p-6"><p className="font-mono text-[10px] uppercase tracking-[.2em] text-primary">Device storage</p><div className="mt-5 flex items-center justify-between"><span className="text-sm text-muted-foreground">Catalog connection</span><span data-testid="status-health" className="flex items-center gap-2 text-xs">{health.isLoading ? 'Checking' : health.isError ? 'Offline' : <><Check className="h-3 w-3 text-[hsl(var(--accent))]" /> Online</>}</span></div><div className="mt-3 h-1 bg-muted"><div className="h-full w-2/3 bg-primary" /></div><p className="mt-3 text-xs text-muted-foreground">Your saved titles never leave this browser.</p></div><Link href="/settings" data-testid="link-settings" className="flex items-center justify-between border border-white/10 bg-card p-6 transition hover:border-white/30"><span className="flex items-center gap-3 text-sm font-semibold"><Settings2 className="h-4 w-4 text-primary" /> Preferences</span><ArrowRight className="h-4 w-4 text-muted-foreground" /></Link></div></div></div>; }

function Preferences() { const [autoplay, setAutoplay] = useState(() => localStorage.getItem('cinema-autoplay') !== 'off'); const [quality, setQuality] = useState(() => localStorage.getItem('cinema-quality') || 'Auto'); const setAutoplayValue = (value: boolean) => { setAutoplay(value); localStorage.setItem('cinema-autoplay', value ? 'on' : 'off'); }; const prefs: { label: string; copy: string; value: boolean; setter: (value: boolean) => void }[] = [{ label: 'Autoplay previews', copy: 'Start a quiet preview when you focus a title.', value: autoplay, setter: setAutoplayValue }, { label: 'Reduce motion', copy: 'Keep transitions calm while browsing.', value: false, setter: () => {} }]; return <div className="space-y-10 pt-10"><PageIntro kicker="Make it comfortable" title="Preferences" copy="Small choices for a better late-night session. These settings stay with this browser." /><div className="max-w-2xl divide-y divide-white/10 border-y border-white/10">{prefs.map(({ label, copy, value, setter }, index) => <div key={label} className="flex items-center justify-between gap-6 py-6"><div><p className="text-sm font-semibold">{label}</p><p className="mt-1 text-xs leading-5 text-muted-foreground">{copy}</p></div><button data-testid={`button-preference-${index}`} onClick={() => setter(!value)} className={`relative h-6 w-11 shrink-0 border transition ${value ? 'border-primary bg-primary' : 'border-white/20 bg-muted'}`} aria-label={`Toggle ${label}`}><span className={`absolute top-1 h-4 w-4 bg-foreground transition ${value ? 'left-6' : 'left-1'}`} /></button></div>)}<div className="flex items-center justify-between gap-6 py-6"><div><p className="text-sm font-semibold">Playback quality</p><p className="mt-1 text-xs leading-5 text-muted-foreground">Let the room adapt to your connection.</p></div><select value={quality} onChange={e => { setQuality(e.target.value); localStorage.setItem('cinema-quality', e.target.value); }} data-testid="select-quality" className="border border-white/15 bg-card px-3 py-2 text-xs text-foreground"><option>Auto</option><option>High</option><option>Data saver</option></select></div></div></div>; }

function Admin({ section = 'overview' }: { section?: string }) { const titles: Record<string, [string, string]> = { overview: ['Studio access', 'The control room is waiting for its operator.'], dashboard: ['Dashboard', 'A quiet overview of your catalog operations.'], users: ['Users', 'Member data will appear here once the studio service is configured.'], content: ['Content', 'Catalog controls are ready for a future editorial workflow.'], settings: ['Settings', 'Studio preferences and integrations will live here.'] }; const [title, copy] = titles[section] || titles.overview; return <div className="space-y-10 pt-10"><div className="flex flex-col justify-between gap-5 border-b border-white/10 pb-8 sm:flex-row sm:items-end"><PageIntro kicker="Cinema/Stream studio" title={title} copy={copy} /><span className="inline-flex h-fit items-center gap-2 border border-[hsl(var(--accent)/.35)] bg-[hsl(var(--accent)/.08)] px-3 py-2 font-mono text-[10px] uppercase tracking-wider text-[hsl(var(--accent))]"><Settings2 className="h-3 w-3" /> Setup required</span></div><div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{['Member data', 'Editorial controls', 'Audience analytics'].map((label, i) => <div key={label} className="border border-white/10 bg-card p-6"><span className="font-mono text-[10px] text-primary">0{i + 1}</span><h2 className="mt-5 font-display text-2xl">{label}</h2><p className="mt-3 text-sm leading-6 text-muted-foreground">This studio surface is intentionally reserved for the server setup that powers it.</p><span className="mt-6 inline-flex border border-white/10 px-2 py-1 font-mono text-[9px] uppercase tracking-wider text-muted-foreground">Unavailable</span></div>)}</div></div>; }

function About() { return <div className="max-w-3xl space-y-10 pt-10"><PageIntro kicker="The fine print" title="About this theater" copy="Cinema Stream is an independent discovery room for finding what to watch next, without pretending every night needs an algorithm." /><section className="grid gap-4 sm:grid-cols-2"><div className="border border-white/10 bg-card p-6"><p className="font-mono text-[10px] uppercase tracking-[.2em] text-primary">Catalog</p><h2 className="mt-4 font-display text-2xl">Powered by TMDB</h2><p className="mt-3 text-sm leading-6 text-muted-foreground">Poster, backdrop, title, cast, genre, and rating metadata comes from The Movie Database through a server-side proxy.</p></div><div className="border border-white/10 bg-card p-6"><p className="font-mono text-[10px] uppercase tracking-[.2em] text-primary">Your room</p><h2 className="mt-4 font-display text-2xl">Guest-first by default</h2><p className="mt-3 text-sm leading-6 text-muted-foreground">My List and watch history stay local on this device until an account service is connected.</p></div></section><p className="border-l-2 border-primary pl-5 text-sm leading-7 text-muted-foreground">This product uses the TMDB API but is not endorsed or certified by TMDB.</p></div>; }

function NotFound() { return <div className="flex min-h-[70vh] flex-col items-start justify-center"><p className="font-mono text-[10px] uppercase tracking-[.25em] text-primary">Reel not found / 404</p><h1 className="mt-4 font-display text-6xl">Cut to black.</h1><p className="mt-4 max-w-md text-sm leading-7 text-muted-foreground">That scene does not exist in this theater. Let us get you back to something good.</p><Link href="/" className="mt-7 flex items-center gap-2 bg-primary px-5 py-3 text-xs font-bold uppercase tracking-[.15em] text-primary-foreground"><ArrowLeft className="h-4 w-4" /> Back to tonight</Link></div>; }

function Router() { return <Shell><ErrorBoundary><Switch><Route path="/" component={Home} /><Route path="/movies" component={() => <Browse type="movie" />} /><Route path="/tv-shows" component={() => <Browse type="tv" />} /><Route path="/genres" component={Genres} /><Route path="/search" component={SearchPage} /><Route path="/movie/:id" component={() => <Detail type="movie" />} /><Route path="/tv/:id" component={() => <Detail type="tv" />} /><Route path="/watch/movie/:id" component={() => <Watch type="movie" />} /><Route path="/watch/tv/:id/:season/:episode" component={() => <Watch type="tv" />} /><Route path="/my-list" component={() => <LocalCollection />} /><Route path="/history" component={() => <LocalCollection history />} /><Route path="/profile" component={Profile} /><Route path="/settings" component={Preferences} /><Route path="/about" component={About} /><Route path="/admin" component={() => <Admin />} /><Route path="/admin/dashboard" component={() => <Admin section="dashboard" />} /><Route path="/admin/users" component={() => <Admin section="users" />} /><Route path="/admin/content" component={() => <Admin section="content" />} /><Route path="/admin/settings" component={() => <Admin section="settings" />} /><Route component={NotFound} /></Switch></ErrorBoundary></Shell>; }

function App() { return <QueryClientProvider client={queryClient}><TooltipProvider><WouterRouter base={import.meta.env.BASE_URL.replace(/\/$/, '')}><Router /></WouterRouter><Toaster /></TooltipProvider></QueryClientProvider>; }

export default App;
