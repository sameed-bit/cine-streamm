# Server-side TMDB credential. The API proxy accepts either a TMDB v3 API key
# or a TMDB API Read Access Token and never sends this value to the browser.
TMDB_API_KEY=

# Optional account service configuration. Supabase was not connected during
# the first build, so the app runs in guest mode until these are configured.
SUPABASE_URL=
SUPABASE_ANON_KEY=